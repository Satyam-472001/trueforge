OPENAI_API_KEY=your_openai_api_key
CLAUDE_API_KEY=your_claude_api_key
DATABASE_URL=postgres://user:password@localhost:5432/database
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY_PATH=./your-app.private-key.pem
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
TRUEFORGE_URL=http://localhost:8790
# Set this only when TrueForge OIDC login is enabled.
TRUEFORGE_TOKEN=
TRUEFORGE_MODEL=openai/gpt-5-4-mini
TRUEFORGE_ISSUE_TRIGGER_LABEL=trueforge:implement
ISSUE_AGENT_TRIGGER_TOKEN=replace_with_a_long_random_value_for_manual_trigger